# Local development only. Copy to .env.local; never commit the copied file.
# The local Edge runtime reaches Ollama through Docker's Windows-host alias.
LOCAL_NLU_URL=http://host.docker.internal:11434
LOCAL_NLU_MODEL=replace-with-an-installed-ollama-model
LOCAL_NLU_DEBUG=true
LOCAL_NLU_REQUIRED=true

# These point to the existing development/approved Supabase project so the
# local function preserves authenticated RLS and document-evidence workflow.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-publishable-anon-key

# No wildcard CORS in local mode. Set this to the Flutter Web origin you run.
INSURANCE_ASSISTANT_ALLOWED_ORIGIN=http://localhost:54882
